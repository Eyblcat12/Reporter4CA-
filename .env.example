# Reporter Pro local configuration.
# setup.bat creates .env from this file when .env does not exist.

# Browser origins allowed to call the local API (comma-separated).
AUTO_REPORT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Import file limit in MB (clamped to 1-512).
AUTO_REPORT_MAX_IMPORT_MB=50

# Maximum number of rows accepted by one report (clamped to 100-500,000).
# The default is intentionally conservative for personal/team workstations.
AUTO_REPORT_MAX_ROWS=50000

# Preview/Generate resource monitoring. Zero means monitor and expose metrics but
# do not cancel automatically. Configure a limit only after measuring the selected
# customer template; row count alone is not a reliable DOCX memory estimate.
AUTO_REPORT_JOB_MEMORY_LIMIT_MB=0
AUTO_REPORT_JOB_TIMEOUT_SECONDS=0
AUTO_REPORT_JOB_RESOURCE_POLL_MS=500

# Automatic local workspace snapshots. Backups contain SQLite state and managed
# DOCX templates, never generated reports or .env secrets.
AUTO_REPORT_AUTO_BACKUP=1
AUTO_REPORT_AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_REPORT_AUTO_BACKUP_RETENTION=7

# Keep runtime file paths inside the repository workspace by default.
AUTO_REPORT_ALLOW_CUSTOM_PATHS=0

# Prepared DOCX templates are content-addressed, integrity checked and can be
# disabled instantly to return to the legacy trim path.
AUTO_REPORT_PREPARED_TEMPLATE=1
AUTO_REPORT_PREPARED_CACHE_ENTRIES=12
AUTO_REPORT_PREPARED_CACHE_MB=512

# Compact prototypes remain experimental because the current benchmark did not
# show a user-visible speedup.
AUTO_REPORT_COMPACT_PROTOTYPE=0

# Conservative simple-cell writer passed the 1,000-asset Phase 3 A/B gate.
# Set to 0 to return immediately to the safe per-cell replacement path.
AUTO_REPORT_FAST_CELL=1

# Preview and Generate share one bounded local document scheduler. Set to 0 for
# immediate compatibility rollback to the previous direct-thread adapters.
AUTO_REPORT_UNIFIED_SCHEDULER=1

# Preview Jobs passed the 10-trial local/team release gate. Set either flag to 0
# for an immediate compatibility rollback without migrating workspace data.
AUTO_REPORT_PREVIEW_JOBS=1
AUTO_REPORT_PREVIEW_CACHE=1
AUTO_REPORT_PREVIEW_TTL_SECONDS=900
AUTO_REPORT_PREVIEW_CACHE_ENTRIES=20
AUTO_REPORT_PREVIEW_CACHE_MB=512

# Optional Elasticsearch plugin. Leave blank unless the plugin is enabled.
# Install its dependency separately: pip install elasticsearch
ELASTIC_HOST=
ELASTIC_INDEX=
