# Reporter Pro local configuration.
# setup.bat creates .env from this file when .env does not exist.

# Browser origins allowed to call the local API (comma-separated).
AUTO_REPORT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Import file limit in MB (clamped to 1-512).
AUTO_REPORT_MAX_IMPORT_MB=50

# Maximum number of rows accepted by one report (clamped to 100-500,000).
# The default is intentionally conservative for personal/team workstations.
AUTO_REPORT_MAX_ROWS=50000

# Keep runtime file paths inside the repository workspace by default.
AUTO_REPORT_ALLOW_CUSTOM_PATHS=0

# Optional Elasticsearch plugin. Leave blank unless the plugin is enabled.
# Install its dependency separately: pip install elasticsearch
ELASTIC_HOST=
ELASTIC_INDEX=
