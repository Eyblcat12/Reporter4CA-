# ============================================================================
# Reporter Pro — .gitignore
# ============================================================================

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.venv/
venv/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ─── Node.js ─────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/

# ─── Vite / Frontend Build ──────────────────────────────────────────────────
apps/frontend/dist/
apps/frontend/test-results/
apps/frontend/playwright-report/

# ─── Electron Build ─────────────────────────────────────────────────────────
artifacts/desktop/dist/
artifacts/benchmarks/
artifacts/soak/
artifacts/golden-docx/
artifacts/review/
artifacts/template-backups/
artifacts/verification/
artifacts/releases/
apps/backend/data/cache/

# ─── Database ────────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─── Environment Variables ───────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
.sixth/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── OS Generated ───────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*

# ─── Temporary & Output Files ───────────────────────────────────────────────
~$*
*.tmp
*.bak
*.log
logs/
.verification/

# ─── Generated Reports (output) ─────────────────────────────────────────────
reporter-report-fixed.docx
*.generated.docx
