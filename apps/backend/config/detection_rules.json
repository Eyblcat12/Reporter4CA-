{
  "schemaVersion": "1.0",
  "rules": [
    {
      "id": "MALWARE_EVIDENCE",
      "name": "Malware evidence detected",
      "enabled": true,
      "severity": "high",
      "classification": "anomaly",
      "conditions": {
        "fields": ["result", "notes", "process", "software"],
        "containsAny": ["phát hiện mã độc", "malware", "trojan", "ransomware", "webshell", "backdoor", "plugx", "mimikatz"],
        "excludeContainsAny": ["no malware", "not detected", "không phát hiện", "không ghi nhận"]
      },
      "remediation": "Isolate the affected asset and validate the evidence with endpoint telemetry.",
      "mitre": []
    },
    {
      "id": "PROXY_TOOL_REVIEW",
      "name": "Proxy or traffic-tunneling tool detected",
      "enabled": true,
      "severity": "medium",
      "classification": "needs_review",
      "conditions": {
        "fields": ["result", "notes", "process", "software", "installed_software"],
        "containsAny": ["proxifier", "tor browser", "psiphon", "ultrasurf"],
        "excludeContainsAny": ["approved", "authorized", "được phê duyệt"]
      },
      "remediation": "Confirm the business purpose, owner, installation source, and related network traffic.",
      "mitre": []
    }
  ]
}
