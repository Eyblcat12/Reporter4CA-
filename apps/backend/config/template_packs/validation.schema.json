{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporter-pro.local/schema/template-pack/validation-1.0.json",
  "title": "Reporter Pro Template Pack validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixturePassed", "integrityPassed", "visualApproved"],
  "properties": {
    "fixturePassed": {"type": "boolean"},
    "integrityPassed": {"type": "boolean"},
    "visualApproved": {"type": "boolean"},
    "fixtureId": {"type": "string", "minLength": 1, "maxLength": 128},
    "validatedAt": {"type": "string", "format": "date-time"},
    "validatorVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "validationRunId": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifactSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "structuralSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewedBy": {"type": "string", "minLength": 1, "maxLength": 128},
    "reviewedAt": {"type": "string", "format": "date-time"}
  }
}
