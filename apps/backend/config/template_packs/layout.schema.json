{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporter-pro.local/schema/template-pack/layout-1.0.json",
  "title": "Reporter Pro Template Pack layout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "displayName",
    "version",
    "reportType",
    "status",
    "slots"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "profileId": {"$ref": "#/$defs/identifier"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "reportType": {
      "enum": ["full", "server_only", "client_only", "summary", "technical", "incident_response"]
    },
    "status": {
      "enum": [
        "draft",
        "analyzed",
        "mapping_incomplete",
        "mapping_complete",
        "test_failed",
        "test_passed",
        "published"
      ]
    },
    "slots": {
      "type": "array",
      "items": {"$ref": "#/$defs/slot"},
      "maxItems": 256
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semantic", "renderer", "anchor", "repeat"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "semantic": {"type": "string", "minLength": 1, "maxLength": 128},
        "renderer": {"type": "string", "minLength": 1, "maxLength": 64},
        "repeat": {"enum": ["once", "per_asset", "per_finding", "per_ioc", "per_timeline_event"]},
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["content_control", "bookmark", "token"]},
            "value": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    }
  }
}
