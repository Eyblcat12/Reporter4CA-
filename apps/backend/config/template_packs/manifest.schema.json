{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reporter-pro.local/schema/template-pack/manifest-1.0.json",
  "title": "Reporter Pro Template Pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "packId", "version", "checksums"],
  "properties": {
    "formatVersion": {"const": "1.0"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template.docx", "layout.json", "mapping.json", "validation.json"],
      "properties": {
        "template.docx": {"$ref": "#/$defs/sha256"},
        "layout.json": {"$ref": "#/$defs/sha256"},
        "mapping.json": {"$ref": "#/$defs/sha256"},
        "validation.json": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
